{% import "utils.pss" as u -%}
/*
 * Generated by peakrdl-pss {{ version }} -- do not edit.
 *
 * Environment wrapper for package {{ d.package_name }}.  Kept in a separate file
 * so the register package itself stays environment-agnostic: this file binds the
 * top group to a concrete address region, which is a property of the system, not
 * of the registers.
 */
package {{ d.package_name }}_top {
    import addr_reg_pkg::*;
    import std_pkg::*;
    import {{ d.package_name }}::*;

    component {{ d.top_type_name }}_wrapper_c {
        {{ d.top_component_name }} regs;
        transparent_addr_space_c<>  sys_mem;

        exec init_up {
            transparent_addr_region_s<> region;
            addr_handle_t h;
            region.size = {{ u.hex(d.top_size) }};
            region.addr = {{ u.hex(d.base_address) }};
            h = sys_mem.add_nonallocatable_region(region);
            regs.set_handle(h);
        }
    }
}
