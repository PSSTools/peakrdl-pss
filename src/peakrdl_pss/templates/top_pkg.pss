{#- The whole package.  This template owns emission *order*: PSS requires
    definition before use, and the scanner produced reg_types and group_types in
    post-order, so rendering them in list order is already correct. -#}
/*
 * Generated by peakrdl-pss {{ version }} -- do not edit.
 *
 * SystemRDL register model exported as a PSS register package.
 * Top: {{ d.top_type_name }}
 */
package {{ d.package_name }} {
    import addr_reg_pkg::*;
    import std_pkg::*;
{% if d.enums and opt.emit_enums != "off" %}

    // ---- encodings ----
{% for et in d.enums %}

{% include "enums.pss" %}
{% endfor %}
{% endif %}

    // ---- register types ----
{% for rt in d.reg_types %}

{% include "reg_struct.pss" %}
{% include "reg_component.pss" %}
{% endfor %}

    // ---- register groups ----
{% for gt in d.group_types %}

{% include "reg_group.pss" %}
{% endfor %}
}
